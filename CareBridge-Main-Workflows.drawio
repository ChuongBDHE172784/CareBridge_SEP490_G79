                    <mxGeometry x="1020" y="130" width="320" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf06-ai-nurse-triage_lane_body_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FC;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="178" width="350" height="1142" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="208" y="220" width="24" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="intake" value="1. Enter symptoms, concern or care question from any active lifecycle stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="95" y="290" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="context" value="2. Optionally select minimum health-record context with explicit consent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="415" y="390" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="prompt" value="3. Build structured intake with approved knowledge context and origin token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="415" y="490" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="ai" value="4. AI returns structured, non-diagnostic orientation and reviewed citations&#10;No final risk classification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#55305F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="735" y="590" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="rules" value="CareBridge rules classify&#10;GREEN / YELLOW / RED" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1095" y="690" width="170" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="green" value="5A. GREEN: show disclaimer, self-care and monitoring guidance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#24552A;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1082.5" y="840" width="195" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="yellow" value="5B. YELLOW: offer verified expert/checklist; request minimum-context consent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#5F4500;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1082.5" y="940" width="195" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="red" value="5C. RED: idempotently open or reuse MF-07 emergency session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1082.5" y="1040" width="195" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="fallback" value="AI unavailable or intake incomplete: ask focused follow-up questions, then apply deterministic conservative fallback guidance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#000000;dashed=1;fontFamily=Arial;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="400" y="693" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="display" value="6. Persist triage outcome; show safe action; return to originating dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="95" y="1160" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Boundary: no diagnosis, prescription, medication instruction or autonomous clinical decision-making." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#000000;dashed=1;fontFamily=Arial;fontSize=11.5;fontColor=#374151;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="720" y="1153" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=1;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="203" y="1268" width="34" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="end_inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="211" y="1276" width="18" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" parent="1" source="s" target="intake" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
