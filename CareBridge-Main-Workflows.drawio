    <diagram id="wf-mf07-emergency-map" name="MF-07 Emergency Map &amp; Nearby Care Support Workflow">
        <mxGraphModel dx="798" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="2200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="wf-mf07-emergency-map_lane_header_0" value="Mother" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Arial;fontColor=#7F1D1D;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="130" width="380" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf07-emergency-map_lane_body_0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="178" width="380" height="1960" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf07-emergency-map_lane_header_1" value="System&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#9;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Arial;fontColor=#1E3A5F;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="420" y="130" width="640" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf07-emergency-map_lane_body_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="420" y="178" width="640" height="1960" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf07-emergency-map_lane_header_2" value="Family" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Arial;fontColor=#55305F;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="130" width="360" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="wf-mf07-emergency-map_lane_body_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FC;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="178" width="360" height="1960" as="geometry"/>
                </mxCell>
                <mxCell id="s" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="218" y="220" width="24" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="open" value="1. Open the emergency map from the dashboard SOS action, a RED triage handoff, or by resuming the active session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="280" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="session" value="2. Open or reuse the ACTIVE emergency session under a per-user lock (trigger MANUAL or AI_TRIAGE); repeated opens stay idempotent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="400" width="280" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="dispatch" value="3. For a newly created session, publish the session-opened event and push the family alert; SMS fallback when every push fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="530" width="280" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="famrecv" value="4. Receive the emergency push and open the alert detail: mother, trigger and time; coordinates only while her consent is active" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#55305F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="530" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="famact" value="5. Call the mother, open directions to the shared location and acknowledge the alert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#55305F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="660" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="consent" value="Active location-sharing consent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="660" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="askconsent" value="6B. Show the consent banner and the disclosure dialog; the 115 quick call and the family alert stay available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="760" y="655" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="agree" value="Agree to share the current location?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="115" y="800" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="grant" value="Store the LOCATION / SHARE consent grant, then re-check it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="760" y="810" width="280" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="readloc" value="6. Read the consented current location; offer a retry and keep the 115 call when it cannot be read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="810" width="280" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="search" value="7. Search nearby care through TrackAsia within 5 / 10 / 15 km (hospital, clinic or health station); drop results outside the radius and rank them by distance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="940" width="280" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="found" value="Any facility inside the radius?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1080" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="noresult" value="8B. Report the empty radius and suggest the next radius or the 115 call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1075" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="refine" value="Widen the radius or change the facility type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="115" y="1075" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="display" value="8. Render the TrackAsia map, the facility markers and the ranked list with distance, data source and verification status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="1230" width="280" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="select" value="9. Select a facility from the list or from a map marker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1360" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="route" value="10. Load the facility detail and request the TrackAsia route: distance, ETA, polyline and turn-by-turn steps; draw it on the map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="1470" width="280" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="action" value="Which safe action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="115" y="1610" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="dial" value="11A. Open the dialer for 115 or the facility number; show the number to dial by hand when the dialer cannot open" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1560" width="280" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="nav" value="11B. Guide the route: follow the position stream, speak the Vietnamese turn instructions, re-route when off-route, and stop on arrival, on signal loss or on consent withdrawal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1690" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="refamily" value="11C. Confirm the family alert; the ACTIVE session is reused, so recipients get no duplicate push" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
