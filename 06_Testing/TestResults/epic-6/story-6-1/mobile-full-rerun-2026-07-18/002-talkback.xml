ếp theo." resource-id="com.samsung.android.accessibility.talkback:id/training_text" class="android.widget.TextView" package="com.samsung.android.accessibility.talkback" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,531][1017,1665]" /></node></node></node></node><node index="1" text="" resource-id="com.samsung.android.accessibility.talkback:id/nav_container" class="android.widget.LinearLayout" package="com.samsung.android.accessibility.talkback" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2022][1080,2123]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.samsung.android.accessibility.talkback" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2022][1080,2123]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.samsung.android.accessibility.talkback" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2022][1080,2123]"><node index="0" text="" resource-id="com.samsung.android.accessibility.talkback:id/training_navigation" class="android.widget.LinearLayout" package="com.samsung.android.accessibility.talkback" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2022][1080,2123]"><node index="0" text="Tiếp theo" resource-id="com.samsu