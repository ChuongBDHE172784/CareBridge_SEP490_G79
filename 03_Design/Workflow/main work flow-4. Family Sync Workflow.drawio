        <mxCell id="note_boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;" value="Boundary: Family Sync only exposes data the Mother agreed to share. Every permission is granted by the Mother (OWNER) after a member is accepted, and can be revoked at any time." vertex="1">
          <mxGeometry height="110" width="280" x="130" y="1690" as="geometry" />
        </mxCell>

