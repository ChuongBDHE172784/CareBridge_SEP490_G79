// CareBridge logical ERD — 55 entities
// Source: current live public schema (63 physical tables).
// DBML requires a column type. The quoted zero-width type keeps types visually blank.
// 7 relationship tables are represented as direct many-to-many references.
// Visualization-only artifact: SQL export is intentionally unsupported.
// Non-key/partial indexes and FK referential actions are intentionally omitted.

Project CareBridge_Logical_ERD {
  database_type: 'PostgreSQL'
  Note: '55 logical entities; data types intentionally hidden for conceptual ERD presentation.'
}

Table care_subjects [headerColor: #6C8EBF] {
