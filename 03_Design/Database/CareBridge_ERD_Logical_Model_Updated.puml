@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor White
  BorderColor #4F4F4F
  FontName Arial
  FontSize 9
}
' left to right direction
skinparam dpi 300
title CareBridge - Entity Relationship Diagram

package "Identity & Access" #EAF2F8 {
  entity "roles" as roles {
    * role_id
      role_code
      role_name
      description
      is_active
      created_at
      updated_at
  }
  entity "users" as users {
    * user_id
      email
      phone
      password_hash
      full_name
      avatar_url
      account_status
      email_verified
      phone_verified
      last_login_at
      created_at
      updated_at
  }
  entity "user_roles" as user_roles {
    * user_role_id
    + user_id
    + role_id
    + assigned_by
      assigned_at
      expires_at
      status
      created_at
      updated_at
  }
  entity "user_sessions" as user_sessions {
    * session_id
    + user_id
      refresh_token_hash
      device_name
      ip_address
      expires_at
      revoked_at
      status
      created_at
      updated_at
  }
  entity "community_profiles" as community_profiles {
    * community_profile_id
    + user_id
      display_name
      public_avatar_url
      interest_stage
      region
      bio
      is_visible
      created_at
      updated_at
  }
  entity "notification_preferences" as notification_preferences {
    * preference_id
    + user_id
      notification_type
      in_app_enabled
      push_enabled
      email_enabled
      quiet_hours_start
      quiet_hours_end
      created_at
      updated_at
  }
  entity "notifications" as notifications {
    * notification_id
    + recipient_user_id
      notification_type
      title
      body
      reference_type
      reference_id
      is_read
      sent_at
      delivery_status
      created_at
      updated_at
  }
  entity "data_permissions" as data_permissions {
    * permission_id
    + owner_user_id
    + grantee_user_id
      scope_type
      scope_reference_id
      purpose
      granted_at
      expires_at
      revoked_at
      status
      created_at
      updated_at
  }
  entity "audit_logs" as audit_logs {
    * audit_log_id
    + actor_user_id
      action
      entity_type
      entity_id
      old_value_json
      new_value_json
      ip_address
      created_at
  }
}

