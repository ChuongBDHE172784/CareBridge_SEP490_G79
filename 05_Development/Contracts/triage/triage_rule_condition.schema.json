{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carebridge.app/contracts/triage/triage_rule_condition.schema.json",
  "title": "CareBridge AI Triage V2 — Rule Registry & Condition DSL",
  "description": "Closed schema for the canonical triage rule registry. The condition DSL is a fixed, non-executable tree: no expression strings, no eval(). Both the Java and the Python evaluator MUST validate every rule against this schema before loading it, and MUST refuse to load any rule that fails validation.",
  "type": "object",
  "required": [
    "rulesetVersion",
    "ruleMatrixVersion",
    "scope",
    "signalCatalog",
    "contextFields",
    "rules"
  ],
  "additionalProperties": true,
  "properties": {
    "rulesetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ruleMatrixVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ruleMatrixApprovedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "ruleMatrixSource": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "stages",
        "outcomes",
        "maximumQuestionRounds"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "enum": [
              "PRECONCEPTION",
              "POSSIBLE_PREGNANCY",
              "PREGNANCY",
              "POSTPARTUM_MOTHER",
              "INFANT_0_12M",
              "TODDLER_12_24M"
            ]
          },
          "minItems": 1
        },
        "outcomes": {
          "type": "array",
          "items": {
            "enum": [
              "RED",
              "YELLOW",
              "GREEN",
              "NEEDS_MORE_INFO",
              "OUT_OF_SCOPE"
            ]
          }
        },
        "maximumQuestionRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "signalCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "type",
          "displayText"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": {
            "enum": [
              "BOOLEAN",
              "NUMBER",
              "ENUM",
              "TEXT"
            ]
          },
          "unit": {
            "type": "string"
          },
          "displayText": {
            "type": "string",
            "minLength": 1
          },
          "globalRed": {
            "type": "boolean"
          }
        }
      }
    },
    "contextFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "BOOLEAN",
              "NUMBER",
              "ENUM",
              "TEXT",
              "TRISTATE"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "ruleType",
        "title",
        "stages",
        "outcome",
        "priority",
        "stopConversation",
        "conditionType",
        "condition",
        "requiredFields",
        "questionIds",
        "exclusions",
        "reasonCode",
        "actionCode",
        "sourceIds",
        "status",
        "effectiveFrom"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "ruleVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "ruleType": {
          "enum": [
            "GLOBAL_RED",
            "STAGE_RED",
            "STAGE_YELLOW",
            "INFO",
            "SYSTEM_INFO",
            "SYSTEM_SCOPE",
            "SYSTEM_DEFAULT"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "PRECONCEPTION",
              "POSSIBLE_PREGNANCY",
              "PREGNANCY",
              "POSTPARTUM_MOTHER",
              "INFANT_0_12M",
              "TODDLER_12_24M"
            ]
          }
        },
        "outcome": {
          "enum": [
            "RED",
            "YELLOW",
            "GREEN",
            "NEEDS_MORE_INFO",
            "OUT_OF_SCOPE"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stopConversation": {
          "type": "boolean"
        },
        "conditionType": {
          "enum": [
            "SIGNAL",
            "ENGINE"
          ]
        },
        "condition": {
          "oneOf": [
            {
              "$ref": "#/definitions/conditionNode"
            },
            {
              "$ref": "#/definitions/enginePredicate"
            }
          ]
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q_[A-Z0-9_]+$"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "actionCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "APPROVED",
            "APPROVED_LEGACY_V1",
            "DRAFT",
            "RETIRED"
          ]
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveFrom": {
          "type": "string"
        },
        "effectiveTo": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$comment": "A RED outcome must always stop the conversation (BR-SAFETY: never keep asking once RED matched).",
          "if": {
            "properties": {
              "outcome": {
                "const": "RED"
              }
            }
          },
          "then": {
            "properties": {
              "stopConversation": {
                "const": true
              }
            }
          }
        },
        {
          "$comment": "conditionType SIGNAL requires a boolean condition tree; ENGINE requires a named predicate.",
          "if": {
            "properties": {
              "conditionType": {
                "const": "ENGINE"
              }
            }
          },
          "then": {
            "properties": {
              "condition": {
                "$ref": "#/definitions/enginePredicate"
              }
            }
          },
          "else": {
            "properties": {
              "condition": {
                "$ref": "#/definitions/conditionNode"
              }
            }
          }
        }
      ]
    },
    "enginePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate"
      ],
      "properties": {
        "predicate": {
          "$comment": "Closed set. Each name maps to a hand-written, deterministic evaluator function on BOTH sides. Adding a name requires code on both sides plus a parity vector.",
          "enum": [
            "MISSING_REQUIRED_FIELDS_AFTER_MAX_ROUNDS",
            "NO_REPRODUCTIVE_RELEVANCE_AND_NO_GLOBAL_RED",
            "MINIMUM_DATASET_COMPLETE_AND_NO_HIGHER_RULE_MATCHED"
          ]
        }
      }
    },
    "conditionNode": {
      "oneOf": [
        {
          "$ref": "#/definitions/allNode"
        },
        {
          "$ref": "#/definitions/anyNode"
        },
        {
          "$ref": "#/definitions/notNode"
        },
        {
          "$ref": "#/definitions/signalLeaf"
        },
        {
          "$ref": "#/definitions/contextLeaf"
        }
      ]
    },
    "allNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/conditionNode"
          }
        }
      }
    },
    "anyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/conditionNode"
          }
        }
      }
    },
    "notNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/definitions/conditionNode"
        }
      }
    },
    "signalLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "operator",
        "value"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "operator": {
          "enum": [
            "EQ",
            "NEQ",
            "GT",
            "GTE",
            "LT",
            "LTE",
            "IN",
            "EXISTS",
            "NOT_EXISTS"
          ]
        },
        "value": {}
      }
    },
    "contextLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "operator",
        "value"
      ],
      "properties": {
        "context": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operator": {
          "enum": [
            "EQ",
            "NEQ",
            "GT",
            "GTE",
            "LT",
            "LTE",
            "IN",
            "EXISTS",
            "NOT_EXISTS"
          ]
        },
        "value": {}
      }
    }
  }
}
