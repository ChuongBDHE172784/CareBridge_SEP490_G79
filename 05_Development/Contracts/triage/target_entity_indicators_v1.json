{
  "$comment": "CANONICAL TARGET-ENTITY INDICATORS — Vietnamese surface cues that suggest a message is about the mother or the baby, shared by the Java and Python resolvers. Deliberately a data file, not code: the two resolvers must key off the same phrase list or they will disagree on who the session is about, and that disagreement would decide which clinical thresholds get applied. No LLM contributes to this file.",
  "contractVersion": "1.1.0",
  "matchingRules": {
    "$comment": "A single word is never sufficient. 'Tôi hỏi giúp con tôi, bé bị sốt' contains 'tôi' but is about the baby. Matching is therefore scored per clause, and a clause that names a possessed child ('con tôi', 'bé nhà em') marks the whole clause BABY regardless of the first-person pronoun that introduced it.",
    "caseInsensitive": true,
    "stripAccentsForMatching": true,
    "clauseSeparators": [
      ",",
      ".",
      ";",
      "!",
      "?",
      " và ",
      " nhưng ",
      " còn ",
      " với "
    ],
    "possessiveOverridesFirstPerson": true,
    "minimumScoreToResolve": 1,
    "conflictWhenBothScorePositive": true,
    "motherClauseRequiresSymptomWhenBabyClausePresent": true
  },
