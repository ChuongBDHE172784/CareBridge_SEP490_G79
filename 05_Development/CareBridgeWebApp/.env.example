VITE_API_URL=http://localhost:8080

# UC-144D Direct Consult Chat & Call — Firebase Web SDK config (public, not a secret in
# the traditional sense, but still project-specific — never hardcode, always via env).
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -> SDK setup and configuration -> Config. Native-mode Cloud Firestore must be enabled in
# the same project. See 05_Development/Firebase/README.md for the full setup guide.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
