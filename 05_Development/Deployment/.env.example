# Copy to .env only on the staging server. Never commit populated values.
BACKEND_IMAGE=registry.example/carebridge-backend@sha256:<64-hex-digest>
WEB_IMAGE=registry.example/carebridge-web@sha256:<64-hex-digest>
AI_IMAGE=registry.example/carebridge-ai@sha256:<64-hex-digest>
EDGE_NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:<64-hex-digest>
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<64-hex-digest>
CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/carebridge/secrets/cloudflare-tunnel-token
CAREBRIDGE_API_HOSTNAME=api.example.com
CAREBRIDGE_CORS_ALLOWED_ORIGINS=https://portal.example.com
CAREBRIDGE_TUNNEL_SUBNET=172.31.0.0/29
CAREBRIDGE_CLOUDFLARED_IP=172.31.0.2
BACKEND_PORT=8080
WEB_PORT=8081
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
# RS256 key material: PKCS#8 private key and SubjectPublicKeyInfo public keys,
# encoded as base64 DER without PEM headers. Keep previous public keys in the
# semicolon-separated ring during a bounded rotation window.
JWT_ACTIVE_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
# Dev seeding is not a staging/production deployment option. Do not add
# CAREBRIDGE_DEV_SEED_ENABLED or CAREBRIDGE_DEV_SEED_PASSWORD to this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carebridge

# Required AI-service evidence-registry contract. docker-compose.staging.yml uses
# ${VAR:?} guards, so either missing or blank values abort Compose before startup.
# Supply the reachable Backend registry URL and an operator-managed internal key
# only in the uncommitted staging environment; never log, publish, or share the key.
AI_TRIAGE_EVIDENCE_REGISTRY_URL=
AI_TRIAGE_INTERNAL_API_KEY=

GEMINI_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
CAREBRIDGE_FCM_ENABLED=false
FIREBASE_CREDENTIALS_BASE64=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 private expert identity objects (Backend only)
R2_ENABLED=false
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carebridge-private
R2_REGION=auto

# Optional CompreFace profile — enable/test on Linux only
COMPREFACE_ENABLED=false
COMPREFACE_BASE_URL=http://compreface-fe
COMPREFACE_API_KEY=
COMPREFACE_SIMILARITY_THRESHOLD=0.75
COMPREFACE_POSTGRES_USER=postgres
COMPREFACE_POSTGRES_PASSWORD=
COMPREFACE_POSTGRES_DB=frs
COMPREFACE_PORT=8000
