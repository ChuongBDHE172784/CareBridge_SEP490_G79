# CareBridge — server deployment environment.
#
# Copy to 05_Development/Deployment/.env.server ON THE SERVER ONLY. That path is
# gitignored. Never commit populated values and never paste them into chat, a
# ticket, or a shared document.
#
#   cp 05_Development/Deployment/server.env.example 05_Development/Deployment/.env.server
#   chmod 600 05_Development/Deployment/.env.server
#
# One file serves two roles: Compose reads it for ${...} interpolation, and the
# backend container receives it as its env file. The AI and web containers do
# not; they get an explicit allowlist.
#
# A literal $ in any value must be written as $$ or Compose will try to expand it.

# ─── Public hostnames (no scheme, no trailing slash) ─────────────────────────
CAREBRIDGE_PORTAL_HOSTNAME=carebridgevn.site
CAREBRIDGE_API_HOSTNAME=api.carebridgevn.site

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
# File containing ONLY the eyJ... token, no "--token" prefix and no quotes.
# Anyone holding it can run a replica of your tunnel.
#   install -m 600 /dev/null /run/carebridge/secrets/cloudflare-tunnel-token
CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/carebridge/secrets/cloudflare-tunnel-token
# Change these together only if 172.31.0.0/29 collides with the VPC or another
# Docker network on the VM.
CAREBRIDGE_TUNNEL_SUBNET=172.31.0.0/29
CAREBRIDGE_CLOUDFLARED_IP=172.31.0.2
CAREBRIDGE_NGINX_EDGE_IP=172.31.0.3

# ─── Images ──────────────────────────────────────────────────────────────────
# Leave the three CareBridge entries commented out to build on the VM. Set them
# to immutable registry digests once the GitLab pipeline pushes images, then
# deploy with `docker compose pull` instead of `--build`.
# BACKEND_IMAGE=registry.gitlab.com/<group>/<project>/carebridge-backend@sha256:<64-hex>
# WEB_IMAGE=registry.gitlab.com/<group>/<project>/carebridge-web@sha256:<64-hex>
# AI_IMAGE=registry.gitlab.com/<group>/<project>/carebridge-ai@sha256:<64-hex>
# EXERCISE_IMAGE=registry.gitlab.com/<group>/<project>/carebridge-exercise@sha256:<64-hex>
EDGE_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.0-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
BACKEND_ENV_FILE=./05_Development/Deployment/.env.server

# ─── Portal build args (Vite inlines these; rebuild the web image to change) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ─── Backend: Spring profile ─────────────────────────────────────────────────
# Must NOT be "local". "local" turns on ddl-auto: update, which makes Hibernate
# ALTER the shared Supabase schema and crash-loop the backend.
SPRING_PROFILES_ACTIVE=supabase

# ─── Backend: database ───────────────────────────────────────────────────────
# Atomic tuple: all three or none. Use the session pooler on port 5432; the
# transaction pooler on 6543 does not keep the session state Flyway needs.
SUPABASE_DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# ─── Backend: Supabase API ───────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carebridge

# ─── Backend: JWT (RS256, base64 DER without PEM headers) ────────────────────
JWT_ACTIVE_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=

# ─── Backend: Firebase ───────────────────────────────────────────────────────
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
FIREBASE_CREDENTIALS_BASE64=
CAREBRIDGE_FCM_ENABLED=true
# Firestore carries direct-chat and call signaling; the feature does not work
# without it.
CAREBRIDGE_FIREBASE_FIRESTORE_ENABLED=true
DIRECTCHAT_FIREBASE_EVENT_RETENTION_HOURS=24
# Only needed in ADC mode or against the Auth emulator; the base64 credentials
# above already carry the project id.
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_ID=

# ─── Backend: background notification workers ────────────────────────────────
# All default to false in application.yaml, so leaving them out ships a
# deployment that quietly never sends a reminder or an appointment notice.
REMINDER_SCHEDULE_NOTIFICATION_ENABLED=true
APPOINTMENT_NOTIFICATION_ENABLED=true
CAREBRIDGE_RECOMMENDATION_ENABLED=true
CAREBRIDGE_CHECKLIST_DISTRIBUTION_V2_ENABLED=true

# ─── Posture analysis sidecar (MediaPipe + exercise correction) ──────────────
# Set false to drop the container and let the backend fall back to RULE_BASED.
CAREBRIDGE_EXERCISE_CORRECTION_ENABLED=true
EXERCISE_MEM_LIMIT=512m
EXERCISE_CPUS=1.0

# ─── Backend: file storage ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=carebridge-documents
R2_REGION=auto

# ─── Backend: mail, maps, calls ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
TRACKASIA_API_KEY=
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ─── Backend: Gemini ─────────────────────────────────────────────────────────
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── AI Triage container (explicit allowlist, separate from the backend) ─────
# Must match on both sides or the evidence registry fails closed and no medical
# source is treated as approved.
AI_TRIAGE_INTERNAL_API_KEY=
AI_GEMINI_ENABLED=true
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash

# ─── CompreFace (Container B) ────────────────────────────────────────────────
# Leave disabled until the stack is up and both API keys exist in its admin UI.
# COMPREFACE_* alone does nothing: application.yaml hard-codes those literals,
# so only the CAREBRIDGE_COMPREFACE_* names below can override them.
CAREBRIDGE_COMPREFACE_ENABLED=false
CAREBRIDGE_COMPREFACE_BASE_URL=http://compreface-fe
CAREBRIDGE_COMPREFACE_DETECTION_API_KEY=
CAREBRIDGE_COMPREFACE_VERIFICATION_API_KEY=
CAREBRIDGE_COMPREFACE_SIMILARITY_THRESHOLD=0.75
COMPREFACE_POSTGRES_USER=postgres
COMPREFACE_POSTGRES_PASSWORD=
COMPREFACE_POSTGRES_DB=frs
# Bound to 127.0.0.1 on the VM; reach it with an SSH tunnel, not the internet.
COMPREFACE_ADMIN_PORT=8000
