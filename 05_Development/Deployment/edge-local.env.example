# Copy to .env.edge-local in this directory. The copied file is ignored by Git.
# Use hostnames from a Cloudflare-managed domain; do not include https:// here.
CAREBRIDGE_PORTAL_HOSTNAME=portal.dev.example.com
CAREBRIDGE_API_HOSTNAME=api.dev.example.com

# Store only the token in this ignored file (no quotes or variable assignment).
# Anyone holding it can run the tunnel. Never commit or paste it into logs.
CLOUDFLARE_TUNNEL_TOKEN_FILE=05_Development/Deployment/cloudflare-tunnel-token.secret

# Version-pinned local defaults are declared in Compose. Override only when
# deliberately testing a reviewed image version or immutable digest.
NODE_IMAGE=node:22.17.1-alpine3.22
EDGE_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.0-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2

# Change these together only if the default Docker subnet collides locally.
CAREBRIDGE_TUNNEL_SUBNET=172.30.0.0/29
CAREBRIDGE_CLOUDFLARED_IP=172.30.0.2
