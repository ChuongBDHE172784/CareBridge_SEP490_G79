GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=6
GEMINI_MAX_RETRIES=1
GEMINI_TEMPERATURE=0.2
AI_TRIAGE_SERVICE_TIMEOUT_SECONDS=7
AI_TRIAGE_REALTIME_TIMEOUT_SECONDS=3.5
AI_TRIAGE_EVIDENCE_REGISTRY_URL=http://localhost:8080
AI_TRIAGE_INTERNAL_API_KEY=
AI_TRIAGE_EVIDENCE_REGISTRY_CACHE_SECONDS=300

# Realtime official-source search backend (Google Programmable Search Engine —
# https://programmablesearchengine.google.com/, free tier: 100 queries/day).
# Leave both blank to disable realtime search (local Knowledge Base citations
# still work). Do NOT replace this with HTML-scraping a general search engine —
# it is unreliable behind bot-detection/CAPTCHA and this service must not
# attempt to bypass CAPTCHAs.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
