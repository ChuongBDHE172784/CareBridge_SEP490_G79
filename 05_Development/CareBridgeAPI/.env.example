# CareBridge API — environment variable template
# Copy to .env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=supabase

# Supabase project API values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Leave empty unless a backend feature explicitly needs admin-level Supabase APIs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carebridge

# Supabase Postgres JDBC connection.
# Use the direct or pooler connection string from Supabase, and keep sslmode=require.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Existing CareBridge security configuration.
JWT_SECRET=replace-with-at-least-32-characters

# Development seed data.
CAREBRIDGE_DEV_SEED_ENABLED=false

# TrackAsia Map API - public key, rate-limited.
TRACKASIA_API_KEY=your-trackasia-api-key

# Gemini API key (optional; leave blank to disable RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=false

# Firebase Admin SDK (used by FCM and Firestore signaling).
# Base64 service-account mode remains the default. To enable it:
#   1. Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
#   2. Base64-encode the downloaded JSON (never commit the raw file):
#        base64 -i service-account.json | tr -d '\n'   (macOS/Linux)
#   3. Paste the output as FIREBASE_CREDENTIALS_BASE64 below and set CAREBRIDGE_FCM_ENABLED=true
#      (works identically in local dev, CI, and Docker — no file path/volume needed)
#
# Keyless ADC mode (safe opt-in; do not set FIREBASE_CREDENTIALS_BASE64 at the same time):
#   1. Local: gcloud auth application-default login
#      Hosted: attach a service account through the platform's workload identity/ADC support.
#   2. Set FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=true and FIREBASE_PROJECT_ID.
#   3. For Firebase custom-token signing, set FIREBASE_SERVICE_ACCOUNT_ID to the managed
#      service-account email below. The ADC principal needs iam.serviceAccounts.signBlob on
#      that account (normally via roles/iam.serviceAccountTokenCreator).
CAREBRIDGE_FCM_ENABLED=false
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
FIREBASE_PROJECT_ID=project-d04b488f-17fb-4ae5-b64
FIREBASE_SERVICE_ACCOUNT_ID=firebase-adminsdk-fbsvc@project-d04b488f-17fb-4ae5-b64.iam.gserviceaccount.com

# UC-144D Direct Consult Chat & Call — Cloud Firestore signaling (ADR-DCC-004).
# Reuses the Firebase Admin SDK credentials above. Leave
# CAREBRIDGE_FIREBASE_FIRESTORE_ENABLED=false to keep using the logging stub —
# chat/call REST endpoints work fully either way; only the realtime "someone sent a
# message" nudge requires this to be enabled.
#   1. Firebase Console -> Firestore Database -> Create database (Native mode)
#   2. Deploy Firestore rules/indexes via the Firebase CLI — see
#      05_Development/Firebase/README.md for the full setup guide.
CAREBRIDGE_FIREBASE_FIRESTORE_ENABLED=false
DIRECTCHAT_CALL_RING_TIMEOUT_SECONDS=45
DIRECTCHAT_FIREBASE_EVENT_RETENTION_HOURS=24

AUTH_FEDERATED_ENABLED=true

# Firebase Auth Emulator (local development only; never enable in production).
# FIREBASE_AUTH_EMULATOR_HOST must not include http:// or https://.
CAREBRIDGE_FIREBASE_AUTH_EMULATOR_ENABLED=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloudinary file upload
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Private file storage. Keep cloudinary for compatibility or switch to r2.
# R2 credentials are backend-only and must never be exposed to Web/Mobile.
FILE_STORAGE_PROVIDER=cloudinary
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carebridge-private
R2_REGION=auto

# Optional Dockerized CompreFace Face Verification service.
# Start: docker compose -f docker-compose.staging.yml -f docker-compose.compreFace.yml --profile compreface up -d
# Then open: http://localhost:8000/login, create a Face Verification service, copy the API key below.
COMPREFACE_ENABLED=true
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=
COMPREFACE_SIMILARITY_THRESHOLD=0.75
COMPREFACE_CONNECT_TIMEOUT_MS=3000
COMPREFACE_READ_TIMEOUT_MS=8000
# JVM memory override for the API container (defaults: -Xmx4g for api, -Xmx1g for admin).
# Leave these commented to use the docker-compose defaults. Uncomment to override.
# COMPREFACE_API_JAVA_OPTS=-Xmx3g
# COMPREFACE_ADMIN_JAVA_OPTS=-Xmx512m

# ZegoCloud (realtime consultation chat/voice/video signaling — UC-144/145/146/154).
# Get these from the ZegoCloud console (https://console.zegocloud.com) for a project's
# "Server Secret" (32-char) — used server-side only to generate short-lived Token04
# session tokens. Never exposed to clients directly; never commit real values.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
