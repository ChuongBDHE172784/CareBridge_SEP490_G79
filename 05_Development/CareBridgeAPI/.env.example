# CareBridge API — environment variable template
# Copy to .env and fill in real values. Never commit .env.

# Spring profile: "dev" (local Docker) or "supabase" (Supabase cloud)
SPRING_PROFILES_ACTIVE=supabase

# Supabase project credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_STORAGE_BUCKET=carebridge-storage

# Supabase Postgres direct connection (Transaction Pooler or Session Pooler)
SUPABASE_DB_URL=jdbc:postgresql://<db-host>:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<db-password>

# JWT signing secret — minimum 32 characters, random
JWT_SECRET=<at-least-32-char-random-secret>

# Gemini API key (optional; leave blank to disable RAG)
GEMINI_API_KEY=
