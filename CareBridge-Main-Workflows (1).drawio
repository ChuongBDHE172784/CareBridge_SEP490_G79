                    <mxGeometry x="208" y="220" width="24" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="feed" value="1. View feed, search/filter topics or open question detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="95" y="290" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="post" value="2. Create question or answer; choose public or anonymous identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="95" y="390" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="screen" value="3. Check spam, abuse, prohibited advertising, reports and health-risk wording" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
