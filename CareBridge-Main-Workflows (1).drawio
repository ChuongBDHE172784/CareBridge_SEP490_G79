                <mxCell id="notify" value="7. Notify answer/moderation outcome and retain traceable event" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
