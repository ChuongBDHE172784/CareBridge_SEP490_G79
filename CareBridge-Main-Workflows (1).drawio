                <mxCell id="risky" value="Screening outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="455" y="590" width="170" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="triage" value="4A. RED health-risk signal: invoke MF-06 rules or open/reuse MF-07 emergency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#581C1C;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="415" y="740" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="review" value="4B. Review pending content, report evidence and topic-governance issue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#24552A;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="735" y="740" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="decision" value="Approve content?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Arial;fontSize=11.5;fontStyle=1;fontColor=#5F4500;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="775" y="850" width="170" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="publish" value="5A. Publish safe content to owning feed/list/detail screen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#1E3A5F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="415" y="970" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="moderate" value="5B. Hide, reject, lock, warn, suspend or request edit; record audit outcome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#24552A;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="735" y="970" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="expert" value="6. Add verified-expert answer with label and scoped visibility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#55305F;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1055" y="1090" width="250" height="58" as="geometry"/>
